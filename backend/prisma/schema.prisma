generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
    url =  env("DATABASE_URL")

}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  products         Product[]
  productMovements ProductMovement[]
  customers        Customer[]
  transactions     Transaction[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Product {
  id          String   @id @default(uuid())
  name        String
  description String?
  userId String
  user   User   @relation(fields: [userId], references: [id])
  movements ProductMovement[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model ProductMovement {
  id       String       @id @default(uuid())
  type     MovementType
  quantity Int
  unitPrice Float
  productId String
  product   Product @relation(fields: [productId], references: [id])

  userId String
  user   User @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([productId])
}

model Customer {
  id    String
  name  String
  email String?

  userId String
  user   User   @relation(fields: [userId], references: [id])

  transactions Transaction[]

  createdAt DateTime @default(now())

  @@id([id])
  @@index([userId])
}

model Transaction {
  id     String            @id @default(uuid())
  type   TransactionType
  status TransactionStatus
  amount Decimal

  userId String
  user   User @relation(fields: [userId], references: [id])

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([customerId])
}

enum MovementType {
  ENTRADA
  SAIDA
}

enum TransactionType {
  VENDA
  COMPRA
}

enum TransactionStatus {
  PENDENTE
  CONCLUIDA
  CANCELADA
}